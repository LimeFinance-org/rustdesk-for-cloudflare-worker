{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rustdesk-for-cloudflare-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"routes": [
		{ "pattern": "rust.example.com", "custom_domain": true }
	],
	"upload_source_maps": true,
	"migrations": [
		{
			"new_sqlite_classes": [
				"Hbbr",
				"Hbbs"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Hbbr",
				"name": "HBBR"
			},
			{
				"class_name": "Hbbs",
				"name": "HBBS"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 80
	}
}
